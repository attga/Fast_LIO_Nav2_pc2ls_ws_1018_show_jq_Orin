  <maintainer email="jackie@example.com">jackie</maintainer>
  <license>BSD</license>
  <test_depend>ament_cmake_gtest</test_depend>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ml_scan_context</depend>
