<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="mid360_robot">
  <!-- 安装数值只放在 YAML；坐标和单位约定见同目录 README。 -->
  <xacro:arg name="mounts_file" default="../config/robot/rear_axle.yaml"/>
  <xacro:arg name="enable_yesense" default="true"/>
  <!-- 兼容旧启动参数，非空时为经过校验的 x y z roll pitch yaw。 -->
  <xacro:arg name="imu_mount" default=""/>
  <xacro:arg name="wheel_mount" default=""/>
  <xacro:arg name="livox_imu_mount" default=""/>
  <xacro:property name="mounts" value="${xacro.load_yaml(xacro.arg('mounts_file'))['mounts']}"/>

  <xacro:macro name="fixed_frame" params="parent child mount override:=''">
    <xacro:property name="pose" value="${override.split() if override else mount['xyz'] + mount['rpy']}"/>
    <link name="${child}"/>
    <joint name="${child}_mount" type="fixed">
      <parent link="${parent}"/>
      <child link="${child}"/>
      <origin xyz="${' '.join(str(v) for v in pose[:3])}"
              rpy="${' '.join(str(v) for v in pose[3:])}"/>
    </joint>
  </xacro:macro>

  <!-- 根坐标系：后轴中心；map/odom 由双 EKF 负责。 -->
  <link name="base_link"/>

  <!-- 轮速消息的 body 兼容别名。 -->
  <xacro:fixed_frame parent="base_link" child="body"
      mount="${mounts['wheel']}" override="$(arg wheel_mount)"/>

  <!-- Yesense 的安装关系独立于 Livox。 -->
  <xacro:if value="$(arg enable_yesense)">
    <xacro:fixed_frame parent="base_link" child="gyro_link"
        mount="${mounts['yesense']}" override="$(arg imu_mount)"/>
  </xacro:if>

  <!-- 先描述整个 Livox 的安装，再描述其内部雷达—IMU 外参。 -->
  <xacro:fixed_frame parent="base_link" child="livox_imu_link"
      mount="${mounts['livox_imu']}" override="$(arg livox_imu_mount)"/>
  <xacro:fixed_frame parent="livox_imu_link" child="livox_lidar_link"
      mount="${mounts['livox_lidar']}"/>
</robot>
