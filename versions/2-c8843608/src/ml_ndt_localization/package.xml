<?xml version="1.0"?>
<package format="3">
  <name>ml_ndt_localization</name>
  <version>0.0.0</version>
  <description>
    Global scan-to-map pose measurements using sensor-time TF predictions,
    body-frame scans and bundled Autoware NDT. Publishes accepted
    map poses, path and quality status; does not publish localization TF.
  </description>
  <maintainer email="jackie@example.com">jackie</maintainer>
  <license>BSD</license>
  <license>Apache-2.0</license>
  <license>BSD-2-Clause</license>
  <license>BSD-3-Clause</license>

  <test_depend>ament_cmake_gtest</test_depend>
  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_srvs</depend>
  <depend>pcl_conversions</depend>
  <depend>tf2_ros</depend>
  <depend>tf2</depend>
  <depend>eigen</depend>
  <depend>libpcl-all-dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
